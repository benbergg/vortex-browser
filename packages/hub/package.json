{
  "name": "@vortex-browser/hub",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./main": "./dist/src/main.js",
    "./paths": "./dist/src/paths.js",
    "./spawn": "./dist/src/spawn.js"
  },
  "bin": {
    "vortex-hub": "dist/src/main.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@vortex-browser/shared": "workspace:*",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "description": "Local multi-client and multi-browser routing hub for Vortex."
}
